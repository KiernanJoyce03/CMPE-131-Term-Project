generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  username  String     @unique
  avatar    String?
  watchlist Watchlist[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Stores metadata for books the user adds (sourced from Google Books API)
model Book {
  id           String      @id  // Google Books volumeId (e.g. "zyTCAlFPjgYC")
  title        String
  author       String
  coverUrl     String?
  description  String?
  watchlist    Watchlist[]
}

// Join table: which user added which book, and what status
model Watchlist {
  id        String          @id @default(uuid())
  userId    String
  bookId    String
  status    WatchlistStatus @default(WANT_TO_READ)
  rating    Int?            // 1–5, null if not rated yet
  review    String?         // optional text review
  startedAt DateTime?       // when the user started reading
  finishedAt DateTime?      // when the user finished
  addedAt   DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId]) // a user can only add a book once
}

enum WatchlistStatus {
  WANT_TO_READ
  READING
  COMPLETED
  DROPPED
}
