generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  username  String     @unique
  watchlist Watchlist[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Stores metadata for books the user adds (sourced from Google Books API)
model Book {
  id           String      @id  // Google Books volumeId (e.g. "zyTCAlFPjgYC")
  title        String
  author       String
  coverUrl     String?
  description  String?
  watchlist    Watchlist[]
}

// Join table: which user added which book, and what status
model Watchlist {
  id        String          @id @default(uuid())
  userId    String
  bookId    String
  status    WatchlistStatus @default(WANT_TO_READ)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book            @relation(fields: [bookId], references: [id])
  addedAt   DateTime        @default(now())

  @@unique([userId, bookId]) // a user can only add a book once
}

enum WatchlistStatus {
  WANT_TO_READ
  READING
  COMPLETED
  DROPPED
}
